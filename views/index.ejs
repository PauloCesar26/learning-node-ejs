<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Cadastro</title>
</head>
<body>
  <h1>Cadastro de Usuário</h1>
  <form action="/enviar" method="POST">
    <label>Nome:</label>
    <input type="text" name="nome" required><br><br>
    
    <label>Email:</label>
    <input type="email" name="email" required><br><br>
    
    <button type="submit">Salvar</button>
    <a href="/user">Users</a>
  </form>
</body>
</html>